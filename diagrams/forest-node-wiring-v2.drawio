<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Wiring" id="wiring-v2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Hardware wiring diagram: IoT sensor node (ESP32 NodeMCU and ESP32-CAM)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="dht" value="&lt;b&gt;DHT22&lt;/b&gt;&lt;br&gt;Temp + humidity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="170" height="155" as="geometry"/></mxCell><mxCell id="soil" value="&lt;b&gt;Soil sensor&lt;/b&gt;&lt;br&gt;Capacitive, analog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="170" height="155" as="geometry"/></mxCell><mxCell id="gps" value="&lt;b&gt;GPS NEO-6M&lt;/b&gt;&lt;br&gt;Location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="170" height="190" as="geometry"/></mxCell><mxCell id="pir" value="&lt;b&gt;PIR HC-SR501&lt;/b&gt;&lt;br&gt;Motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="170" height="155" as="geometry"/></mxCell><mxCell id="mcu" value="&lt;b&gt;ESP32 NodeMCU&lt;/b&gt;&lt;br&gt;Sensor controller, MQTT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="260" height="745" as="geometry"/></mxCell><mxCell id="cam" value="&lt;b&gt;ESP32-CAM&lt;/b&gt;&lt;br&gt;Photo on motion, HTTP upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="240" height="230" as="geometry"/></mxCell><mxCell id="pb" value="&lt;b&gt;Portable power bank&lt;/b&gt;&lt;br&gt;5V USB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="240" height="120" as="geometry"/></mxCell><mxCell id="dht_DATA" value="DATA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="60" height="26" as="geometry"/></mxCell><mxCell id="dht_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="145" width="60" height="26" as="geometry"/></mxCell><mxCell id="dht_VCC" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="60" height="26" as="geometry"/></mxCell><mxCell id="soil_VCC" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="295" width="60" height="26" as="geometry"/></mxCell><mxCell id="soil_AOUT" value="AOUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="60" height="26" as="geometry"/></mxCell><mxCell id="soil_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="365" width="60" height="26" as="geometry"/></mxCell><mxCell id="gps_TX" value="TX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="480" width="60" height="26" as="geometry"/></mxCell><mxCell id="gps_RX" value="RX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="515" width="60" height="26" as="geometry"/></mxCell><mxCell id="gps_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="550" width="60" height="26" as="geometry"/></mxCell><mxCell id="gps_VCC" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="585" width="60" height="26" as="geometry"/></mxCell><mxCell id="pir_VCC" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="700" width="60" height="26" as="geometry"/></mxCell><mxCell id="pir_OUT" value="OUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="735" width="60" height="26" as="geometry"/></mxCell><mxCell id="pir_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="770" width="60" height="26" as="geometry"/></mxCell><mxCell id="m4" value="GPIO 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="90" height="26" as="geometry"/></mxCell><mxCell id="mg1" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="145" width="90" height="26" as="geometry"/></mxCell><mxCell id="m33" value="3V3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="237" width="90" height="26" as="geometry"/></mxCell><mxCell id="m34" value="GPIO 34" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="90" height="26" as="geometry"/></mxCell><mxCell id="mg2" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="365" width="90" height="26" as="geometry"/></mxCell><mxCell id="m16" value="GPIO 16 (RX2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="480" width="90" height="26" as="geometry"/></mxCell><mxCell id="m17" value="GPIO 17 (TX2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="515" width="90" height="26" as="geometry"/></mxCell><mxCell id="mg3" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="550" width="90" height="26" as="geometry"/></mxCell><mxCell id="mvin" value="VIN (5V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="585" width="90" height="26" as="geometry"/></mxCell><mxCell id="m27" value="GPIO 27" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="735" width="90" height="26" as="geometry"/></mxCell><mxCell id="mg4" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="770" width="90" height="26" as="geometry"/></mxCell><mxCell id="musb" value="USB in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="90" height="26" as="geometry"/></mxCell><mxCell id="cpw" value="5V / GND (USB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="110" height="26" as="geometry"/></mxCell><mxCell id="c13" value="GPIO 13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="500" width="110" height="26" as="geometry"/></mxCell><mxCell id="pb1" value="USB 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="70" height="26" as="geometry"/></mxCell><mxCell id="pb2" value="USB 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="145" width="70" height="26" as="geometry"/></mxCell><mxCell id="w1" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="dht_DATA" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w2" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="dht_GND" target="mg1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w3" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#CC0000;" edge="1" parent="1" source="dht_VCC" target="m33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w4" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#CC0000;" edge="1" parent="1" source="soil_VCC" target="m33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w5" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="soil_AOUT" target="m34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w6" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="soil_GND" target="mg2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w7" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="gps_TX" target="m16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w8" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="gps_RX" target="m17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w9" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="gps_GND" target="mg3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w10" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#E67E22;" edge="1" parent="1" source="gps_VCC" target="mvin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w11" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#E67E22;" edge="1" parent="1" source="pir_VCC" target="mvin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w12" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="pir_OUT" target="m27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w13" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="pir_GND" target="mg4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w14" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="pir_OUT" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="748"/><mxPoint x="230" y="830"/><mxPoint x="870" y="830"/><mxPoint x="870" y="513"/></Array></mxGeometry></mxCell><mxCell id="u1" value="USB cable" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#E67E22;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb1" target="musb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u2" value="USB to 5V pin" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#E67E22;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb2" target="cpw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="158"/><mxPoint x="850" y="453"/></Array></mxGeometry></mxCell><mxCell id="l1" value="Red = 3.3V power" style="text;html=1;align=left;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1"><mxGeometry x="900" y="215" width="240" height="22" as="geometry"/></mxCell><mxCell id="l2" value="Orange = 5V power and USB" style="text;html=1;align=left;fontStyle=1;fontColor=#E67E22;" vertex="1" parent="1"><mxGeometry x="900" y="240" width="240" height="22" as="geometry"/></mxCell><mxCell id="l3" value="Black = Ground" style="text;html=1;align=left;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="265" width="240" height="22" as="geometry"/></mxCell><mxCell id="l4" value="Green = Signal" style="text;html=1;align=left;fontStyle=1;fontColor=#2E9E3E;" vertex="1" parent="1"><mxGeometry x="900" y="290" width="240" height="22" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;1. The soil sensor is on GPIO 34 (ADC1). The ESP32-CAM has no free ADC1 pin, and ADC2 stops working when Wi-Fi is on. So the NodeMCU reads the sensors.&lt;br&gt;2. The PIR output goes to both boards. The NodeMCU reports motion in telemetry. The ESP32-CAM takes the photo.&lt;br&gt;3. All grounds join through the power bank.&lt;br&gt;4. The ESP32 has one 3V3 pin. Share it with the breadboard rail.&lt;br&gt;5. A bare 4-pin DHT22 needs a 10k resistor between DATA and 3V3.&lt;br&gt;6. GPS needs a clear view of the sky. The PIR needs about a minute to warm up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="635" width="270" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>