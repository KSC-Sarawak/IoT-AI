<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Data flow" id="data-flow-full"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Data flow chart: IoT sensor node to admin dashboard" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1000" height="30" as="geometry"/></mxCell><mxCell id="zf" value="Field: IoT sensor node (power bank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8ee;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="430" height="340" as="geometry"/></mxCell><mxCell id="zs" value="Server: backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f0f9;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="50" width="440" height="420" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;DHT22&lt;/b&gt;&lt;br&gt;Temp, humidity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="140" height="46" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Soil sensor&lt;/b&gt;&lt;br&gt;Soil moisture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="140" height="46" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;PIR sensor&lt;/b&gt;&lt;br&gt;Motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="140" height="46" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;GPS module&lt;/b&gt;&lt;br&gt;Location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="295" width="140" height="46" as="geometry"/></mxCell><mxCell id="esp" value="&lt;b&gt;ESP32-CAM&lt;/b&gt;&lt;br&gt;Reads sensors, builds JSON, takes a photo on motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="140" height="170" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Wi-Fi router or hotspot&lt;/b&gt;&lt;br&gt;Connectivity gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="130" height="70" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;Mosquitto broker&lt;/b&gt;&lt;br&gt;MQTT with TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="170" height="60" as="geometry"/></mxCell><mxCell id="pm" value="&lt;b&gt;Processing Module&lt;/b&gt;&lt;br&gt;Rules or pre-trained model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="170" height="60" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;Auth, validation, alert logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="180" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;Readings, images, alerts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="380" width="170" height="70" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b&gt;Admin web dashboard&lt;/b&gt;&lt;br&gt;Live data, alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="380" width="190" height="60" as="geometry"/></mxCell><mxCell id="es1" value="temp, humidity" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.12;" edge="1" parent="1" source="s1" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es2" value="moisture" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.38;" edge="1" parent="1" source="s2" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es3" value="motion" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.62;" edge="1" parent="1" source="s3" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es4" value="location" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.88;" edge="1" parent="1" source="s4" target="esp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="MQTT telemetry" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="esp" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="HTTP POST image" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="esp" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="MQTT 8883 (TLS)" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw" target="mq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="211"/><mxPoint x="685" y="130"/></Array></mxGeometry></mxCell><mxCell id="e4" value="HTTPS image upload" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="239"/><mxPoint x="790" y="285"/></Array></mxGeometry></mxCell><mxCell id="e5" value="subscribe to topics" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mq" target="pm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="store readings, report anomaly" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pm" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="save" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="live data and alerts down, thresholds and acknowledgements up" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=block;startFill=1;exitX=0.7;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="api" target="dash"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g1" value="Green = in the forest" style="text;html=1;align=left;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="200" height="24" as="geometry"/></mxCell><mxCell id="g2" value="Purple = server side" style="text;html=1;align=left;fontStyle=1;fontColor=#7E57C2;" vertex="1" parent="1"><mxGeometry x="260" y="405" width="200" height="24" as="geometry"/></mxCell><mxCell id="g3" value="Gray = network" style="text;html=1;align=left;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="405" width="200" height="24" as="geometry"/></mxCell><mxCell id="n" value="1. The node publishes JSON telemetry over MQTT with TLS. When the PIR sees motion, it sends a photo by HTTP POST.&lt;br&gt;2. The Processing Module checks readings against per-node thresholds or a pre-trained model. It raises an alert only after a sustained breach.&lt;br&gt;3. A lost node is detected through the broker (for example an MQTT Last Will message).&lt;br&gt;4. A Python telemetry simulator can publish the same JSON when the hardware is not available." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="640" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>