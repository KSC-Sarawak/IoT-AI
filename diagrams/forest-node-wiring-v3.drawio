<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram name="Wiring v3" id="wiring-v3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Hardware wiring diagram v3: IoT sensor node built from the available kit" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="dht" value="&lt;b&gt;DHT11&lt;/b&gt;&lt;br&gt;Temp + humidity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="170" height="155" as="geometry"/></mxCell><mxCell id="soil" value="&lt;b&gt;YL-69 soil sensor&lt;/b&gt;&lt;br&gt;Resistive, analog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="170" height="155" as="geometry"/></mxCell><mxCell id="gps" value="&lt;b&gt;GPS: not fitted&lt;/b&gt;&lt;br&gt;Fixed latitude and longitude stored in the firmware (config.h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="170" height="90" as="geometry"/></mxCell><mxCell id="pir" value="&lt;b&gt;PIR unit&lt;/b&gt;&lt;br&gt;Motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="170" height="155" as="geometry"/></mxCell><mxCell id="mcu" value="&lt;b&gt;ESP32 NodeMCU&lt;/b&gt;&lt;br&gt;Reads sensors, publishes MQTT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="260" height="645" as="geometry"/></mxCell><mxCell id="cam" value="&lt;b&gt;ESP32-CAM (optional)&lt;/b&gt;&lt;br&gt;Not in kit. Photo on motion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="240" height="190" as="geometry"/></mxCell><mxCell id="pb" value="&lt;b&gt;Portable power bank&lt;/b&gt;&lt;br&gt;5V USB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="240" height="120" as="geometry"/></mxCell><mxCell id="dht_DATA" value="DATA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="60" height="26" as="geometry"/></mxCell><mxCell id="dht_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="145" width="60" height="26" as="geometry"/></mxCell><mxCell id="dht_VCC" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="60" height="26" as="geometry"/></mxCell><mxCell id="soil_VCC" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="295" width="60" height="26" as="geometry"/></mxCell><mxCell id="soil_A0" value="A0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="330" width="60" height="26" as="geometry"/></mxCell><mxCell id="soil_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="365" width="60" height="26" as="geometry"/></mxCell><mxCell id="pir_5V" value="5V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="600" width="60" height="26" as="geometry"/></mxCell><mxCell id="pir_OUT" value="OUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="635" width="60" height="26" as="geometry"/></mxCell><mxCell id="pir_GND" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="670" width="60" height="26" as="geometry"/></mxCell><mxCell id="m4" value="GPIO 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="100" height="26" as="geometry"/></mxCell><mxCell id="mg1" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="145" width="100" height="26" as="geometry"/></mxCell><mxCell id="m33" value="3V3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="180" width="100" height="26" as="geometry"/></mxCell><mxCell id="m25" value="GPIO 25 (VCC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="295" width="100" height="26" as="geometry"/></mxCell><mxCell id="m34" value="GPIO 34" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="100" height="26" as="geometry"/></mxCell><mxCell id="mg2" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="365" width="100" height="26" as="geometry"/></mxCell><mxCell id="mvin" value="VIN (5V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="600" width="100" height="26" as="geometry"/></mxCell><mxCell id="m27" value="GPIO 27" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="635" width="100" height="26" as="geometry"/></mxCell><mxCell id="mg3" value="GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="670" width="100" height="26" as="geometry"/></mxCell><mxCell id="musb" value="USB in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="90" height="26" as="geometry"/></mxCell><mxCell id="cpw" value="5V / GND (USB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="110" height="26" as="geometry"/></mxCell><mxCell id="c13" value="GPIO 13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="490" width="110" height="26" as="geometry"/></mxCell><mxCell id="pb1" value="USB 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="70" height="26" as="geometry"/></mxCell><mxCell id="pb2" value="USB 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="145" width="70" height="26" as="geometry"/></mxCell><mxCell id="w1" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="dht_DATA" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w2" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="dht_GND" target="mg1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w3" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#CC0000;" edge="1" parent="1" source="dht_VCC" target="m33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w4" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#CC0000;" edge="1" parent="1" source="soil_VCC" target="m25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w5" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="soil_A0" target="m34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w6" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="soil_GND" target="mg2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w7" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#E67E22;" edge="1" parent="1" source="pir_5V" target="mvin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w8" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;" edge="1" parent="1" source="pir_OUT" target="m27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w9" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#000000;" edge="1" parent="1" source="pir_GND" target="mg3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w10" value="" style="endArrow=none;html=1;strokeWidth=3;strokeColor=#2E9E3E;dashed=1;" edge="1" parent="1" source="pir_OUT" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="648"/><mxPoint x="230" y="740"/><mxPoint x="870" y="740"/><mxPoint x="870" y="503"/></Array></mxGeometry></mxCell><mxCell id="u1" value="USB cable" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#E67E22;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb1" target="musb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u2" value="USB to 5V pin" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#E67E22;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="pb2" target="cpw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="158"/><mxPoint x="850" y="443"/></Array></mxGeometry></mxCell><mxCell id="l1" value="Red = 3.3V power" style="text;html=1;align=left;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1"><mxGeometry x="900" y="205" width="240" height="22" as="geometry"/></mxCell><mxCell id="l2" value="Orange = 5V power and USB" style="text;html=1;align=left;fontStyle=1;fontColor=#E67E22;" vertex="1" parent="1"><mxGeometry x="900" y="228" width="240" height="22" as="geometry"/></mxCell><mxCell id="l3" value="Black = Ground" style="text;html=1;align=left;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="251" width="240" height="22" as="geometry"/></mxCell><mxCell id="l4" value="Green = Signal" style="text;html=1;align=left;fontStyle=1;fontColor=#2E9E3E;" vertex="1" parent="1"><mxGeometry x="900" y="274" width="240" height="22" as="geometry"/></mxCell><mxCell id="l5" value="Dashed = optional or not fitted" style="text;html=1;align=left;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="297" width="240" height="22" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;1. The YL-69 is powered from GPIO 25. The code turns it on only while reading. This slows corrosion.&lt;br&gt;2. DHT11: a 3-pin board wires as shown. A bare 4-pin DHT11 needs a 10k resistor between DATA and 3V3.&lt;br&gt;3. PIR unit: its Grove cable has black = GND, red = 5V, and a white or yellow signal wire. Confirm which wire is OUT, and check that OUT is 3.3V.&lt;br&gt;4. GPS is not fitted. Put a fixed latitude and longitude per node in the firmware.&lt;br&gt;5. The ESP32-CAM is optional. Its motion trigger uses the same PIR OUT wire.&lt;br&gt;6. All grounds join through the power bank." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="580" width="270" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>